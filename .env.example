# Optional. OpenAI vision (gpt-4o-mini) — best card ID from a photo.
OPENAI_API_KEY=

# Optional. Google Gemini vision fallback if OpenAI is not set.
GEMINI_API_KEY=

# Optional. Higher pokemontcg.io rate limits. Free key: https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=

# eBay App ID is entered in the app (first screen) and stored on the phone.
# Do not put a real App ID here.

# Optional. Override USD→CAD rate. If unset, the app fetches a public daily rate.
# USD_CAD_RATE=1.37

# Hosted Next/PWA origin used by the Galaxy Store APK (static UI in the wrapper).
# Example: https://your-app.vercel.app
# NEXT_PUBLIC_API_ORIGIN=

# Optional. Load a live PWA URL in the WebView instead of the bundled www/ assets.
# Intended for local debug, not the store binary.
# CAPACITOR_SERVER_URL=
