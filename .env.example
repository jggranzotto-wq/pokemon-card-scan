# Optional. OpenAI vision (gpt-4o-mini) — best card ID from a photo.
OPENAI_API_KEY=

# Optional. Google Gemini vision fallback if OpenAI is not set.
GEMINI_API_KEY=

# Optional. Higher pokemontcg.io rate limits. Free key: https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=

# Postgres connection string. Required for the collection, price history, and eBay seller tokens.
# Local: postgres://cardscan:cardscan@localhost:5432/cardscan
# Railway: use the Postgres plugin variable. Do not commit a real URL.
DATABASE_URL=

# Set to 1 on hosts that require SSL (Railway public proxy). Localhost stays unencrypted.
# DATABASE_SSL=1

# Shared password for the collection API. Required on any public host.
# The phone stores the same value in Settings. Leave unset only for localhost.
COLLECTION_PASSWORD=

# Signs thumbnail URLs and the eBay OAuth state. Use a long random string in production.
SESSION_SECRET=

# Protects POST /api/jobs/refresh-prices. The daily worker can also run `npm run refresh-prices` directly.
CRON_SECRET=

# Optional. Seller calendar for "yesterday". Defaults to America/Toronto.
# COLLECTION_TIMEZONE=America/Toronto

# Optional. Override USD→CAD. If unset, Frankfurter's public daily rate is used and labeled as an estimate.
# USD_CAD_RATE=1.37

# Public origin of this Next app, used after eBay OAuth and for absolute links.
# APP_PUBLIC_URL=https://your-app.up.railway.app

# Baked into the Android wrapper so the APK calls this hosted origin. Not needed for the website.
# NEXT_PUBLIC_API_ORIGIN=https://your-app.up.railway.app

# Collectr partner API. Register at https://getcollectr.com/api
# Leave the key empty until Collectr sends it. Prices stay "Not connected".
# Set COLLECTR_API_BASE to the host in their docs if it is not https://api.getcollectr.com
COLLECTR_API_KEY=
# COLLECTR_API_BASE=https://api.getcollectr.com
# COLLECTR_SEARCH_PATH=/v1/catalog/search
# COLLECTR_PRODUCT_PATH=/v1/catalog/products/{id}

# eBay developer keys. App ID (Client ID) and Cert ID. Never commit real values.
# Sold comps try Marketplace Insights (needs eBay approval). Listing creation uses the same keys plus a RuName.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName whose Accept URL is https://YOUR-HOST/api/ebay/callback
EBAY_RUNAME=
# sandbox (default) or production. Production posts live listings.
EBAY_ENV=sandbox
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_CATEGORY_ID=183454
# Inventory location. Country defaults to CA. Postal code is required before a listing can publish.
EBAY_COUNTRY=CA
EBAY_POSTAL_CODE=
# EBAY_CITY=
# EBAY_STATE=
# Optional policy ids. If empty, the app creates sandbox business policies on first publish.
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_MERCHANT_LOCATION_KEY=the-midnightman
# Legacy Finding API App ID if it differs from EBAY_CLIENT_ID. Phone App ID still works for one-off refreshes.
# EBAY_FINDING_APP_ID=
